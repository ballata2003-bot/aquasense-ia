# ============================================================
# AquaSense IA — variables de entorno (SOLO nombres/valores de ejemplo).
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas ".env" a GitHub (ya está en .gitignore).
# ============================================================

# --- Servidor ---
PORT=3001
# Orígenes extra permitidos por CORS (separados por coma). Vacío = solo mismo origen (recomendado).
ALLOWED_ORIGINS=
# Habilita /api/simulador/* (demo y mediciones). Pon false si no lo quieres público.
ENABLE_SIMULADOR=true

# --- Modelo de lenguaje (Groq) ---
# Clave PROPIA del equipo, de https://console.groq.com. Déjala vacía para usar el modo simulado (mock).
GROQ_API_KEY=
# groq = LLM real · mock = respuestas simuladas (solo pruebas; /health lo declara). Vacío = groq si hay clave, si no mock.
LLM_MODE=
MODEL_COORDINADOR=openai/gpt-oss-120b
MODEL_ESPECIALISTA=openai/gpt-oss-20b
# low | medium | high (vacío = no enviar el parámetro)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1500
LLM_REINTENTOS=2

# --- Límites anti-bucle y de consumo ---
MAX_PASOS_COORDINADOR=6
MAX_PASOS_ESPECIALISTA=4
MAX_LLAMADAS_LLM=14
MAX_DELEGACIONES=5
TIMEOUT_SOLICITUD_MS=45000
TIMEOUT_HERRAMIENTA_MS=3000
MAX_MENSAJE_CHARS=500
RATE_LIMIT_POR_MIN=20
RATE_LIMIT_GENERAL_POR_MIN=120
TOPE_DIARIO_LLM=500

# --- Precios para estimar costo (USD por 1M de tokens). Verifica en https://groq.com/pricing ---
PRECIO_COORD_IN_USD_M=0.15
PRECIO_COORD_OUT_USD_M=0.60
PRECIO_ESP_IN_USD_M=0.075
PRECIO_ESP_OUT_USD_M=0.30

# --- Persistencia (opcional) ---
# memory = todo en memoria (por defecto) · sqlserver = replica trazas/decisiones y habilita /api/sensores etc.
STORAGE=memory
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AquaSenseDB
DB_USER=
DB_PASSWORD=
DB_USE_WINDOWS_AUTH=false
DB_ENCRYPT=false
# En producción: DB_TRUST_SERVER_CERT=false y un certificado real
DB_TRUST_SERVER_CERT=true
# Solo para docker compose --profile sqlserver
MSSQL_SA_PASSWORD=
